# ── Server ──────────────────────────────────────────────
PORT=8080
APP_ENV=development

# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_DSN=postgres://applad:change-me@postgres:5432/applad?sslmode=disable
DB_PASSWORD=change-me
POSTGREST_URL=http://postgrest:3000

# ── Cache ────────────────────────────────────────────────
REDIS_ADDR=redis:6379

# ── Auth ─────────────────────────────────────────────────
# Must be a strong random secret in production
JWT_SECRET=change-me-in-production

# ── Storage ──────────────────────────────────────────────
STORAGE_PATH=/var/applad/storage

# ── Console ──────────────────────────────────────────────
# "auto" = signup enabled until first user registers, then disabled
# "true" = always allow signup, "false" = never allow signup
CONSOLE_SIGNUP_ENABLED=auto
