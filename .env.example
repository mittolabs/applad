# ─────────────────────────────────────────────────────────────────────────────
# Applad — environment configuration
#
# For local development the docker-compose.yml defaults work without this file.
# For production: copy to .env and fill in the required values below.
#
#   printf "JWT_SECRET=$(openssl rand -hex 32)\nDB_PASSWORD=$(openssl rand -hex 16)\n" > .env
#
# OAuth providers (Google, GitHub, Apple, etc.) are configured per-project
# through the Applad console UI — no env vars needed for them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DB_PASSWORD=change-me                           # REQUIRED in production
DATABASE_DSN=postgres://applad:change-me@pgbouncer:5432/applad?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=redis:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production — must be at least 32 characters.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=/var/applad/storage
# Driver: "local" (default) or "s3"
STORAGE_DRIVER=local
# S3 / compatible object storage (Backblaze B2, MinIO, Cloudflare R2, etc.)
# Leave blank when STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Console ───────────────────────────────────────────────────────────────────
# "auto" = signup enabled until first user registers, then disabled
# "true"  = always allow signup
# "false" = never allow signup
CONSOLE_SIGNUP_ENABLED=auto

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@applad.local

# ── Email — alternative providers (set one or none) ──────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
RESEND_API_KEY=

# ── SMS ───────────────────────────────────────────────────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

# ── Push notifications ────────────────────────────────────────────────────────
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=

# ── Console OAuth (optional) ──────────────────────────────────────────────────
# Enables "Continue with GitHub / Google / SSO" on the Applad admin login page.
# These are separate from per-project OAuth, which is configured in the console UI.
CONSOLE_GITHUB_CLIENT_ID=
CONSOLE_GITHUB_CLIENT_SECRET=
CONSOLE_GOOGLE_CLIENT_ID=
CONSOLE_GOOGLE_CLIENT_SECRET=
# SSO — any OIDC-compatible provider (Okta, Auth0, Azure AD, etc.)
CONSOLE_SSO_CLIENT_ID=
CONSOLE_SSO_CLIENT_SECRET=
CONSOLE_SSO_AUTH_URL=
CONSOLE_SSO_TOKEN_URL=
CONSOLE_SSO_USERINFO_URL=
