# ── Server ──────────────────────────────────────────────
PORT=8080
APP_ENV=development

# ── Database ─────────────────────────────────────────────
# MariaDB connection string
DATABASE_DSN=applad:applad@tcp(mariadb:3306)/applad?parseTime=true
DB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me

# ── Cache ────────────────────────────────────────────────
REDIS_ADDR=redis:6379

# ── Auth ─────────────────────────────────────────────────
# Must be a strong random secret in production
JWT_SECRET=change-me-in-production

# ── Storage ──────────────────────────────────────────────
STORAGE_PATH=/var/applad/storage

# ── Workflows (n8n) ──────────────────────────────────────
# Must be a strong random secret in production
N8N_ENCRYPTION_KEY=change-me-in-production
