# Static SPA served by Caddy: return the requested file if it exists, else
# index.html (client-side routing). Reached only through the edge proxy.
:80 {
	root * /srv
	encode gzip

	# Security headers on the console document. The console holds a bearer token
	# in the browser, so a strict CSP is its defense-in-depth against script
	# injection exfiltrating it, and frame-ancestors blocks clickjacking.
	#   - connect-src 'self': the API is same-origin (/v1 via the edge), incl. ws.
	#   - style-src 'unsafe-inline': React/Tailwind set element style attributes.
	#   - img-src data:/blob:: avatars and generated/preview images.
	header {
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	@assets path /assets/*
	@document not path /assets/*

	# Vite puts a hash of the contents in every asset filename, so a given name
	# never changes meaning and can be cached for good.
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# index.html must not be. It is the map to those hashed names, and a browser
	# holding yesterday's copy asks for chunks this release deleted. Without an
	# explicit header browsers cache it heuristically, which is how a console
	# tab ends up permanently pointing at files that are gone.
	header @document Cache-Control "no-cache"

	# A missing asset is a 404, not the app.
	#
	# The catch-all below exists for client-side routes, but it also swallowed
	# /assets/*: a chunk removed by the next release came back as index.html
	# with a 200 and a content type of text/html, so the browser got a document
	# where it expected a module and every lazily-loaded page in the console
	# died with "Failed to fetch dynamically imported module". A real 404 is
	# something the app can recognise and recover from.
	handle /assets/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	# An error is never cacheable, whatever the request matched. Without this a
	# 404 for a missing asset inherits the immutable header above and the
	# browser holds on to the failure for a year.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
